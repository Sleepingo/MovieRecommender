import ast
import difflib
from pathlib import Path

import pandas as pd
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import linear_kernel
from sklearn.preprocessing import MinMaxScaler


# ============================================================
# 1. CONFIGURATION
# ============================================================

FILE_PATH = Path(r"C:\Users\benja\AI\tmdb_5000_movies.csv")

DEFAULT_NUMBER_OF_RECOMMENDATIONS = 10

# Hybrid recommendation weights.
CONTENT_WEIGHT = 0.80
RATING_WEIGHT = 0.15
POPULARITY_WEIGHT = 0.05


# ============================================================
# 2. LOAD THE DATASET
# ============================================================

def load_movies(file_path):
    """
    Load the TMDB movie dataset and check that the required
    columns exist.
    """

    if not file_path.exists():
        raise FileNotFoundError(
            "\nThe dataset was not found.\n"
            f"Expected location: {file_path}\n"
            "Check that the file path and file name are correct."
        )

    dataframe = pd.read_csv(file_path)

    required_columns = [
        "title",
        "genres",
        "keywords",
        "overview",
        "popularity",
        "vote_average",
        "vote_count"
    ]

    missing_columns = [
        column
        for column in required_columns
        if column not in dataframe.columns
    ]

    if missing_columns:
        raise ValueError(
            "The following required columns are missing from "
            f"the dataset: {missing_columns}"
        )

    return dataframe[required_columns].copy()


# Load the CSV file.
movies = load_movies(FILE_PATH)

print("Dataset loaded successfully.")
print(f"Original number of movies: {len(movies):,}")


# ============================================================
# 3. CLEAN THE DATA
# ============================================================

# Remove rows without movie titles.
movies = movies.dropna(subset=["title"])

# Remove extra spaces around titles.
movies["title"] = movies["title"].astype(str).str.strip()

# Remove duplicate titles.
movies = movies.drop_duplicates(
    subset=["title"],
    keep="first"
)

# Replace missing text values.
movies["overview"] = movies["overview"].fillna("")
movies["genres"] = movies["genres"].fillna("[]")
movies["keywords"] = movies["keywords"].fillna("[]")

# Convert numeric columns to numbers.
numeric_columns = [
    "popularity",
    "vote_average",
    "vote_count"
]

for column in numeric_columns:
    movies[column] = pd.to_numeric(
        movies[column],
        errors="coerce"
    ).fillna(0)

# Reset indexes so that they match the TF-IDF matrix rows.
movies = movies.reset_index(drop=True)

print(f"Movies available after cleaning: {len(movies):,}")


# ============================================================
# 4. EXTRACT GENRES AND KEYWORDS
# ============================================================

def extract_names(value):
    """
    Extract the 'name' fields from TMDB JSON-like data.

    Example input:
    [
        {"id": 28, "name": "Action"},
        {"id": 878, "name": "Science Fiction"}
    ]

    Example output:
    "Action Science Fiction"
    """

    try:
        if isinstance(value, list):
            items = value
        else:
            items = ast.literal_eval(str(value))

        names = []

        for item in items:
            if isinstance(item, dict):
                name = item.get("name")

                if name:
                    names.append(str(name).strip())

        return " ".join(names)

    except (ValueError, SyntaxError, TypeError):
        return ""


movies["genres_text"] = movies["genres"].apply(
    extract_names
)

movies["keywords_text"] = movies["keywords"].apply(
    extract_names
)


# ============================================================
# 5. CREATE THE COMBINED TEXT FEATURES
# ============================================================

# Genres are repeated to give genres more importance than
# ordinary words from a movie overview.
movies["combined_features"] = (
    movies["genres_text"]
    + " "
    + movies["genres_text"]
    + " "
    + movies["keywords_text"]
    + " "
    + movies["overview"]
).str.lower()


# ============================================================
# 6. CREATE THE TF-IDF MODEL
# ============================================================

# TF-IDF converts movie text into numerical vectors.
#
# Movies with similar genres, keywords, and descriptions will
# have similar numerical vectors.
tfidf = TfidfVectorizer(
    stop_words="english",
    max_features=15000,
    ngram_range=(1, 2)
)

tfidf_matrix = tfidf.fit_transform(
    movies["combined_features"]
)

print(f"TF-IDF matrix shape: {tfidf_matrix.shape}")


# ============================================================
# 7. CALCULATE QUALITY, RATING, AND POPULARITY SCORES
# ============================================================

# A movie with one perfect rating should not automatically rank
# above a movie with thousands of ratings. Therefore, a weighted
# rating is used.
#
# Weighted rating formula:
#
#             v                 m
# WR = --------------- × R + ----------- × C
#          v + m              v + m
#
# R = movie's average rating
# v = movie's number of votes
# C = average rating across all movies
# m = minimum votes needed for greater confidence

average_rating = movies["vote_average"].mean()
minimum_votes = movies["vote_count"].quantile(0.60)

v = movies["vote_count"]
r = movies["vote_average"]
c = average_rating
m = minimum_votes

movies["weighted_rating"] = (
    (v / (v + m)) * r
    + (m / (v + m)) * c
)

# Normalize values to the range 0 to 1.
rating_scaler = MinMaxScaler()
popularity_scaler = MinMaxScaler()

movies["rating_score"] = rating_scaler.fit_transform(
    movies[["weighted_rating"]]
).flatten()

movies["popularity_score"] = (
    popularity_scaler.fit_transform(
        movies[["popularity"]]
    ).flatten()
)


# ============================================================
# 8. FORMAT THE RECOMMENDATION RESULTS
# ============================================================

def format_results(results, score_column, limit):
    """
    Select, rename, and format the columns shown to the user.
    """

    output = results[
        [
            "title",
            "genres_text",
            "vote_average",
            "vote_count",
            "popularity",
            score_column
        ]
    ].head(limit).copy()

    output.columns = [
        "Movie",
        "Genres",
        "Rating",
        "Votes",
        "Popularity",
        "Score"
    ]

    output["Rating"] = output["Rating"].round(1)
    output["Popularity"] = output["Popularity"].round(1)
    output["Score"] = output["Score"].round(3)
    output["Votes"] = output["Votes"].astype(int)

    output = output.reset_index(drop=True)
    output.index = output.index + 1
    output.index.name = "Rank"

    return output


# ============================================================
# 9. SEARCH FOR A MOVIE
# ============================================================

def find_movie(movie_title):
    """
    Find a movie from an exact or partial title.

    If several movies match, allow the user to choose one.
    """

    search_text = movie_title.strip().casefold()

    if not search_text:
        return None

    # First, try an exact title match.
    exact_matches = movies[
        movies["title"].str.casefold() == search_text
    ]

    if not exact_matches.empty:
        return exact_matches.index[0]

    # If there is no exact match, try a partial match.
    partial_matches = movies[
        movies["title"].str.contains(
            movie_title,
            case=False,
            na=False,
            regex=False
        )
    ].head(10)

    if not partial_matches.empty:
        print("\nPossible matching movies:")

        partial_indexes = partial_matches.index.tolist()

        for number, movie_index in enumerate(
            partial_indexes,
            start=1
        ):
            title = movies.loc[movie_index, "title"]
            print(f"{number}. {title}")

        while True:
            selection = input(
                "\nSelect a movie number, or press Enter "
                "to cancel: "
            ).strip()

            if selection == "":
                return None

            if selection.isdigit():
                selected_number = int(selection)

                if 1 <= selected_number <= len(partial_indexes):
                    return partial_indexes[selected_number - 1]

            print(
                f"Please enter a number from 1 to "
                f"{len(partial_indexes)}."
            )

    # If there is no partial match, use close spelling matches.
    close_titles = difflib.get_close_matches(
        movie_title,
        movies["title"].tolist(),
        n=5,
        cutoff=0.5
    )

    print(f"\nMovie '{movie_title}' was not found.")

    if close_titles:
        print("Did you mean:")

        for title in close_titles:
            print(f"- {title}")
    else:
        print("No similar movie titles were found.")

    return None


# ============================================================
# 10. RECOMMEND MOVIES FROM A MOVIE TITLE
# ============================================================

def recommend_by_movie(movie_title, number_of_movies=10):
    """
    Recommend movies similar to a movie selected by the user.

    The final score uses:
    - 80% content similarity
    - 15% weighted rating
    - 5% popularity
    """

    movie_index = find_movie(movie_title)

    if movie_index is None:
        return pd.DataFrame(), None

    selected_title = movies.loc[movie_index, "title"]

    # Compare the selected movie with all movies.
    content_scores = linear_kernel(
        tfidf_matrix[movie_index],
        tfidf_matrix
    ).flatten()

    results = movies.copy()
    results["content_similarity"] = content_scores

    # Calculate the final hybrid score.
    results["recommendation_score"] = (
        CONTENT_WEIGHT * results["content_similarity"]
        + RATING_WEIGHT * results["rating_score"]
        + POPULARITY_WEIGHT * results["popularity_score"]
    )

    # Remove the selected movie from its own recommendations.
    results = results.drop(index=movie_index)

    results = results.sort_values(
        by="recommendation_score",
        ascending=False
    )

    formatted_results = format_results(
        results,
        score_column="recommendation_score",
        limit=number_of_movies
    )

    return formatted_results, selected_title


# ============================================================
# 11. RECOMMEND MOVIES FROM USER PREFERENCES
# ============================================================

def recommend_by_preferences(
    preferences,
    number_of_movies=10
):
    """
    Recommend movies from genres, keywords, or a description.

    Example input:
    "science fiction space aliens adventure"
    """

    cleaned_preferences = preferences.strip().lower()

    if not cleaned_preferences:
        print("\nPlease enter at least one preference.")
        return pd.DataFrame()

    # Convert the user's text to a TF-IDF vector using the same
    # vocabulary used for the movie dataset.
    user_vector = tfidf.transform([cleaned_preferences])

    # If none of the input words exist in the TF-IDF vocabulary,
    # the vector will contain no recognized features.
    if user_vector.nnz == 0:
        print(
            "\nThe entered words were not recognized in the "
            "movie dataset."
        )
        print(
            "Try words such as action, comedy, romance, space, "
            "alien, superhero, crime, war, or family."
        )
        return pd.DataFrame()

    content_scores = linear_kernel(
        user_vector,
        tfidf_matrix
    ).flatten()

    results = movies.copy()
    results["content_similarity"] = content_scores

    results["recommendation_score"] = (
        CONTENT_WEIGHT * results["content_similarity"]
        + RATING_WEIGHT * results["rating_score"]
        + POPULARITY_WEIGHT * results["popularity_score"]
    )

    results = results.sort_values(
        by="recommendation_score",
        ascending=False
    )

    return format_results(
        results,
        score_column="recommendation_score",
        limit=number_of_movies
    )


# ============================================================
# 12. SHOW POPULAR AND HIGHLY RATED MOVIES
# ============================================================

def get_popular_movies(number_of_movies=10):
    """
    Return movies using both weighted rating and popularity.
    """

    results = movies.copy()

    results["general_score"] = (
        0.75 * results["rating_score"]
        + 0.25 * results["popularity_score"]
    )

    results = results.sort_values(
        by="general_score",
        ascending=False
    )

    return format_results(
        results,
        score_column="general_score",
        limit=number_of_movies
    )


# ============================================================
# 13. ASK HOW MANY RECOMMENDATIONS TO SHOW
# ============================================================

def ask_recommendation_count():
    """
    Ask the user for the number of recommendations.

    Pressing Enter uses the default value of 10.
    """

    value = input(
        "\nHow many recommendations would you like? "
        f"[Default: {DEFAULT_NUMBER_OF_RECOMMENDATIONS}]: "
    ).strip()

    if value == "":
        return DEFAULT_NUMBER_OF_RECOMMENDATIONS

    if value.isdigit():
        number = int(value)

        if 1 <= number <= 50:
            return number

    print(
        "Invalid number. The default value of "
        f"{DEFAULT_NUMBER_OF_RECOMMENDATIONS} will be used."
    )

    return DEFAULT_NUMBER_OF_RECOMMENDATIONS


# ============================================================
# 14. DISPLAY THE MAIN MENU
# ============================================================

def display_menu():
    print("\n" + "=" * 65)
    print("HYBRID MOVIE RECOMMENDER SYSTEM")
    print("=" * 65)
    print("1. Recommend movies from a movie title")
    print("2. Recommend movies from genres or keywords")
    print("3. Show popular and highly rated movies")
    print("4. Exit")
    print("=" * 65)


# ============================================================
# 15. RUN THE INTERACTIVE PROGRAM
# ============================================================

def main():
    """
    Main user interaction loop.
    """

    while True:
        display_menu()

        choice = input("Select an option (1-4): ").strip()

        # ----------------------------------------------------
        # Option 1: Recommend from a movie title
        # ----------------------------------------------------
        if choice == "1":
            movie_title = input(
                "\nEnter a movie title: "
            ).strip()

            if not movie_title:
                print("You did not enter a movie title.")
                continue

            number_of_movies = ask_recommendation_count()

            recommendations, selected_title = recommend_by_movie(
                movie_title,
                number_of_movies
            )

            if not recommendations.empty:
                print(
                    f"\nBecause you selected '{selected_title}', "
                    "you may also like:"
                )
                print(recommendations.to_string())

        # ----------------------------------------------------
        # Option 2: Recommend from preferences
        # ----------------------------------------------------
        elif choice == "2":
            print(
                "\nEnter genres, keywords, or a short "
                "description."
            )
            print(
                "Example: science fiction space alien adventure"
            )
            print(
                "Example: romantic comedy wedding relationship"
            )

            preferences = input(
                "\nEnter your preferences: "
            ).strip()

            if not preferences:
                print("You did not enter any preferences.")
                continue

            number_of_movies = ask_recommendation_count()

            recommendations = recommend_by_preferences(
                preferences,
                number_of_movies
            )

            if not recommendations.empty:
                print(
                    f"\nRecommendations for '{preferences}':"
                )
                print(recommendations.to_string())

        # ----------------------------------------------------
        # Option 3: Popular movies
        # ----------------------------------------------------
        elif choice == "3":
            number_of_movies = ask_recommendation_count()

            recommendations = get_popular_movies(
                number_of_movies
            )

            print("\nPopular and highly rated movies:")
            print(recommendations.to_string())

        # ----------------------------------------------------
        # Option 4: Exit
        # ----------------------------------------------------
        elif choice == "4":
            print(
                "\nThank you for using the movie "
                "recommender system."
            )
            break

        else:
            print("\nInvalid option. Please select 1, 2, 3, or 4.")


# ============================================================
# 16. START THE PROGRAM
# ============================================================

if __name__ == "__main__":
    try:
        main()

    except KeyboardInterrupt:
        print("\n\nProgram stopped by the user.")

    except EOFError:
        print("\n\nNo input was available. Program stopped.")

    except Exception as error:
        print(f"\nAn unexpected error occurred: {error}")
